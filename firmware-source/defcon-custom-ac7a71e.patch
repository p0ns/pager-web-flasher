+    {"Classic Pager", "Pager:d=16,o=6,b=180:c,p,g,p,c,p,g,8p"},
+    {"Dispatch", "Dispatch:d=16,o=6,b=210:g,p,b,p,d7,8p,g,p,d7"},
+    {"Matrix Chirp", "Matrix:d=32,o=6,b=240:e,g,b,e7,p,b,g,e,8p"},
+};
+static constexpr size_t ringtoneChoiceCount = sizeof(ringtoneChoices) / sizeof(ringtoneChoices[0]);
+#endif
+
 const StoredMessage *getNewestMessageForActiveThread()
 {
     const auto &messages = messageStore.getMessages();
@@ -2131,12 +2149,29 @@ void menuHandler::bluetoothToggleMenu()
 
 void menuHandler::BuzzerModeMenu()
 {
+#ifdef T_LORA_PAGER
+    static const char *optionsArray[] = {"All Enabled", "All Disabled", "Notifications", "System Only",
+                                         "DMs Only",    "Ringtone",     "Volume"};
+#else
     static const char *optionsArray[] = {"All Enabled", "All Disabled", "Notifications", "System Only", "DMs Only"};
+#endif
     BannerOverlayOptions bannerOptions;
     bannerOptions.message = "Notification Sounds";
     bannerOptions.optionsArrayPtr = optionsArray;
-    bannerOptions.optionsCount = 5;
+    bannerOptions.optionsCount = sizeof(optionsArray) / sizeof(optionsArray[0]);
     bannerOptions.bannerCallback = [](int selected) -> void {
+#ifdef T_LORA_PAGER
+        if (selected == 5) {
+            menuQueue = RingtoneMenu;
+            screen->runNow();
+            return;
+        }
+        if (selected == 6) {
+            menuQueue = VolumeMenu;
+            screen->runNow();
+            return;
+        }
+#endif
         config.device.buzzer_mode = (meshtastic_Config_DeviceConfig_BuzzerMode)selected;
         service->reloadConfig(SEGMENT_CONFIG);
     };
@@ -2144,6 +2179,69 @@ void menuHandler::BuzzerModeMenu()
     screen->showOverlayBanner(bannerOptions);
 }
 
+void menuHandler::ringtoneMenu()
+{
+#ifdef T_LORA_PAGER
+    static const char *optionsArray[] = {"Back", ringtoneChoices[0].name, ringtoneChoices[1].name, ringtoneChoices[2].name,
+                                         ringtoneChoices[3].name};
+    BannerOverlayOptions bannerOptions;
+    bannerOptions.message = "Ringtone";
+    bannerOptions.optionsArrayPtr = optionsArray;
+    bannerOptions.optionsCount = sizeof(optionsArray) / sizeof(optionsArray[0]);
+    bannerOptions.InitialSelected = (uiconfig.ring_tone_id < ringtoneChoiceCount) ? uiconfig.ring_tone_id + 1 : 1;
+    bannerOptions.bannerCallback = [](int selected) -> void {
+        if (selected > 0 && static_cast<size_t>(selected) <= ringtoneChoiceCount) {
+            const uint8_t ringtoneId = static_cast<uint8_t>(selected - 1);
+            uiconfig.ring_tone_id = ringtoneId;
+            saveUIConfig();
+            if (externalNotificationModule) {
+                externalNotificationModule->handleSetRingtone(ringtoneChoices[ringtoneId].rtttl);
+            }
+        }
+        menuQueue = BuzzerModeMenuPicker;
+        screen->runNow();
+    };
+    screen->showOverlayBanner(bannerOptions);
+#else
+    menuQueue = BuzzerModeMenuPicker;
+    screen->runNow();
+#endif
+}
+
+void menuHandler::volumeMenu()
+{
+#ifdef T_LORA_PAGER
+    static const char *optionsArray[] = {"Back", "100%", "75%", "50%", "25%", "0%"};
+    static constexpr uint8_t volumeLevels[] = {100, 75, 50, 25, 0};
+
+    BannerOverlayOptions bannerOptions;
+    bannerOptions.message = "Volume";
+    bannerOptions.optionsArrayPtr = optionsArray;
+    bannerOptions.optionsCount = sizeof(optionsArray) / sizeof(optionsArray[0]);
+
+    const uint8_t currentVolume = getTLoraPagerVolume();
+    bannerOptions.InitialSelected = 0;
+    for (size_t i = 0; i < sizeof(volumeLevels) / sizeof(volumeLevels[0]); i++) {
+        if (volumeLevels[i] == currentVolume) {
+            bannerOptions.InitialSelected = static_cast<int>(i + 1);
+            break;
+        }
+    }
+
+    bannerOptions.bannerCallback = [](int selected) -> void {
+        if (selected > 0 && static_cast<size_t>(selected) <= sizeof(volumeLevels) / sizeof(volumeLevels[0])) {
+            setTLoraPagerVolume(volumeLevels[selected - 1]);
+        }
+        menuQueue = BuzzerModeMenuPicker;
+        screen->runNow();
+    };
+    screen->showOverlayBanner(bannerOptions);
+#else
+    menuQueue = BuzzerModeMenuPicker;
+    screen->runNow();
+#endif
+}
+
 void menuHandler::BrightnessPickerMenu()
 {
     static const char *optionsArray[] = {"Back", "Low", "Medium", "High"};
@@ -2846,6 +2944,12 @@ void menuHandler::handleMenuSwitch(OLEDDisplay *display)
     case BuzzerModeMenuPicker:
         BuzzerModeMenu();
         break;
+    case RingtoneMenu:
+        ringtoneMenu();
+        break;
+    case VolumeMenu:
+        volumeMenu();
+        break;
     case MuiPicker:
         switchToMUIMenu();
         break;
