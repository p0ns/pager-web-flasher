 #ifdef T_LORA_PAGER
 
 #include "AudioBoard.h"
+#include "FSCommon.h"
+#include "SafeFile.h"
+#include "TLoraPagerAudio.h"
 
 DriverPins PinsAudioBoardES8311;
 AudioBoard board(AudioDriverES8311, PinsAudioBoardES8311);
 
+namespace
+{
+constexpr uint8_t DEFAULT_AUDIO_VOLUME = 75;
+constexpr const char *AUDIO_VOLUME_FILE = "/prefs/audio-volume";
+uint8_t currentAudioVolume = DEFAULT_AUDIO_VOLUME;
+
+uint8_t loadAudioVolume()
+{
+#ifdef FSCom
+    auto file = FSCom.open(AUDIO_VOLUME_FILE, FILE_O_READ);
+    if (file) {
+        const int savedVolume = file.read();
+        file.close();
+        if (savedVolume >= 0 && savedVolume <= 100) {
+            return static_cast<uint8_t>(savedVolume);
+        }
+    }
+#endif
+    return DEFAULT_AUDIO_VOLUME;
+}
+} // namespace
+
+uint8_t getTLoraPagerVolume()
+{
+    return currentAudioVolume;
+}
+
+void setTLoraPagerVolume(uint8_t volume)
+{
+    if (volume > 100) {
+        return;
+    }
+
+    currentAudioVolume = volume;
+    board.setVolume(volume);
+
+#ifdef FSCom
+    FSCom.mkdir("/prefs");
+    SafeFile file(AUDIO_VOLUME_FILE, true);
+    file.write(volume);
+    file.close();
+#endif
+}
+
 // TLora Pager specific init
 void lateInitVariant()
 {
@@ -23,6 +70,7 @@ void lateInitVariant()
     cfg.i2s.bits = BIT_LENGTH_16BITS;
     cfg.i2s.rate = RATE_44K;
     board.begin(cfg);
-    board.setVolume(75); // 75% volume
+    currentAudioVolume = loadAudioVolume();
+    board.setVolume(currentAudioVolume);
 }
